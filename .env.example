# Copy to .env and fill in. Generate secrets with: openssl rand -base64 48
APP_ENV=development
ADDR=:8080
DATABASE_URL=postgres://meowshot:meowshot@localhost:5432/meowshot?sslmode=disable
# Set to true only when running behind a reverse proxy (Caddy/Nginx) that sets X-Forwarded-For.
TRUST_PROXY=false

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
LOCATION_SECRET=change-me-to-another-long-random-string-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=1440h
# Optional: require this code to create an account (AUTH-5). Leave empty for open sign-up.
INVITE_CODE=

# Google Sign-In: comma-separated OAuth client IDs accepted as the ID token audience
# (Web client ID used by @react-native-google-signin, plus iOS / Android client IDs).
GOOGLE_CLIENT_IDS=

# Backblaze B2 (S3-compatible API). Bucket must be PRIVATE.
# Endpoint is shown on the bucket page, e.g. https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=meowshot-photos
B2_KEY_ID=
B2_APP_KEY=
B2_PATH_STYLE=true
SIGNED_URL_TTL=15m
MAX_UPLOAD_MB=15

# SMTP for password reset codes. If SMTP_HOST is empty, emails are written to the log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Meowshot <no-reply@example.com>
