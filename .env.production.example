# Production config for the VPS (compose.prod.yml). Copy to .env.production and fill in:
#   cp .env.production.example .env.production && chmod 600 .env.production
# Generate secrets with: openssl rand -hex 32

# Postgres runs in Docker on this VPS; DATABASE_URL is built from this in compose.prod.yml.
# Use hex (no special characters) so the URL needs no escaping.
POSTGRES_PASSWORD=

APP_ENV=production
JWT_SECRET=
LOCATION_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=1440h
# Optional: require this code to create an account. Leave empty for open sign-up.
INVITE_CODE=

# Comma-separated Google OAuth client IDs (Web, iOS, Android).
GOOGLE_CLIENT_IDS=

# Backblaze B2 (S3-compatible API). Bucket must be PRIVATE.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=meowshot-photos
B2_KEY_ID=
B2_APP_KEY=
B2_PATH_STYLE=true
SIGNED_URL_TTL=15m
MAX_UPLOAD_MB=15
# Parallel image decodes; each can use a few hundred MB. Keep 1 on a 1–2 GB VPS.
IMAGE_WORKERS=1

# SMTP for password reset codes. If SMTP_HOST is empty, codes are only written to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Meowshot <no-reply@example.com>"
